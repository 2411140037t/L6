<h1>カートに入れる</h1>

<% if @cart_item.errors.any? %>
  <ul style="color:red">
    <% @cart_item.errors.full_messages.each do |m| %>
      <li><%= m %></li>
    <% end %>
  </ul>
<% end %>

<p>商品名：<%= @product.name %></p>
<p>価格：<%= number_with_delimiter(@product.price) %>円</p>

<%= form_with model: @cart_item, url: cartitems_path do |f| %>
  <%= f.hidden_field :product_id %>
  <p>数量：<%= f.number_field :qty, min: 1 %></p>
  <%= f.submit "カートに追加" %>
<% end %>
<%= link_to '商品一覧に戻る', products_path %>