<h1>商品登録</h1>

<% if @product.errors.any? %>
  <ul style="color:red">
    <% @product.errors.full_messages.each do |m| %>
      <li><%= m %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @product do |f| %>
  <p>商品名：<%= f.text_field :name %></p>
  <p>価格：<%= f.number_field :price %> 円</p>
  <%= f.submit "登録" %>
<% end %>
<%= link_to '戻る', products_path %>